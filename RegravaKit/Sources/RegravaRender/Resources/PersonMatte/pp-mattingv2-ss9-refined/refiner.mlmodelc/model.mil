program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.7.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 576, 1024]> alpha, tensor<fp16, [1, 8, 576, 1024]> hidden, tensor<fp16, [1, 3, 576, 1024]> image) {
            int32 var_11 = const()[name = string("op_11"), val = int32(1)];
            bool input_1_interleave_0 = const()[name = string("input_1_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 12, 576, 1024]> input_1_cast_fp16 = concat(axis = var_11, interleave = input_1_interleave_0, values = (image, alpha, hidden))[name = string("input_1_cast_fp16")];
            string input_3_pad_type_0 = const()[name = string("input_3_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_3_pad_0 = const()[name = string("input_3_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_3_strides_0 = const()[name = string("input_3_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_3_dilations_0 = const()[name = string("input_3_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 input_3_groups_0 = const()[name = string("input_3_groups_0"), val = int32(1)];
            tensor<fp16, [16, 12, 3, 3]> const_2_to_fp16 = const()[name = string("const_2_to_fp16"), val = tensor<fp16, [16, 12, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp16, [16]> const_3_to_fp16 = const()[name = string("const_3_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(3584)))];
            tensor<fp16, [1, 16, 576, 1024]> input_5_cast_fp16 = conv(bias = const_3_to_fp16, dilations = input_3_dilations_0, groups = input_3_groups_0, pad = input_3_pad_0, pad_type = input_3_pad_type_0, strides = input_3_strides_0, weight = const_2_to_fp16, x = input_1_cast_fp16)[name = string("input_5_cast_fp16")];
            tensor<fp16, [1, 16, 576, 1024]> input_7_cast_fp16 = relu(x = input_5_cast_fp16)[name = string("input_7_cast_fp16")];
            string input_9_pad_type_0 = const()[name = string("input_9_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_9_pad_0 = const()[name = string("input_9_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_9_strides_0 = const()[name = string("input_9_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_9_dilations_0 = const()[name = string("input_9_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 input_9_groups_0 = const()[name = string("input_9_groups_0"), val = int32(1)];
            tensor<fp16, [16, 16, 3, 3]> const_4_to_fp16 = const()[name = string("const_4_to_fp16"), val = tensor<fp16, [16, 16, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(3712)))];
            tensor<fp16, [16]> const_5_to_fp16 = const()[name = string("const_5_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(8384)))];
            tensor<fp16, [1, 16, 576, 1024]> input_11_cast_fp16 = conv(bias = const_5_to_fp16, dilations = input_9_dilations_0, groups = input_9_groups_0, pad = input_9_pad_0, pad_type = input_9_pad_type_0, strides = input_9_strides_0, weight = const_4_to_fp16, x = input_7_cast_fp16)[name = string("input_11_cast_fp16")];
            tensor<fp16, [1, 16, 576, 1024]> input_13_cast_fp16 = relu(x = input_11_cast_fp16)[name = string("input_13_cast_fp16")];
            string input_15_pad_type_0 = const()[name = string("input_15_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_15_pad_0 = const()[name = string("input_15_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_15_strides_0 = const()[name = string("input_15_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_15_dilations_0 = const()[name = string("input_15_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 input_15_groups_0 = const()[name = string("input_15_groups_0"), val = int32(1)];
            tensor<fp16, [8, 16, 3, 3]> const_6_to_fp16 = const()[name = string("const_6_to_fp16"), val = tensor<fp16, [8, 16, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(8512)))];
            tensor<fp16, [8]> const_7_to_fp16 = const()[name = string("const_7_to_fp16"), val = tensor<fp16, [8]>([-0x1.9cp-3, -0x1.aecp-2, 0x1.ea8p-2, -0x1.7f4p-4, 0x1.6ecp-4, 0x1.a5p-1, 0x1.324p-2, 0x1.afcp-4])];
            tensor<fp16, [1, 8, 576, 1024]> input_17_cast_fp16 = conv(bias = const_7_to_fp16, dilations = input_15_dilations_0, groups = input_15_groups_0, pad = input_15_pad_0, pad_type = input_15_pad_type_0, strides = input_15_strides_0, weight = const_6_to_fp16, x = input_13_cast_fp16)[name = string("input_17_cast_fp16")];
            tensor<fp16, [1, 8, 576, 1024]> input_19_cast_fp16 = relu(x = input_17_cast_fp16)[name = string("input_19_cast_fp16")];
            string residual_pad_type_0 = const()[name = string("residual_pad_type_0"), val = string("valid")];
            tensor<int32, [2]> residual_strides_0 = const()[name = string("residual_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [4]> residual_pad_0 = const()[name = string("residual_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> residual_dilations_0 = const()[name = string("residual_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 residual_groups_0 = const()[name = string("residual_groups_0"), val = int32(1)];
            tensor<fp16, [1, 8, 1, 1]> refiner_out_weight_to_fp16 = const()[name = string("refiner_out_weight_to_fp16"), val = tensor<fp16, [1, 8, 1, 1]>([[[[0x1.878p-6]], [[-0x1.d38p-5]], [[0x1.88p-7]], [[-0x1.e84p-6]], [[0x1.30cp-5]], [[-0x1.7e4p-7]], [[0x1.c14p-7]], [[-0x1.25p-4]]]])];
            tensor<fp16, [1]> refiner_out_bias_to_fp16 = const()[name = string("refiner_out_bias_to_fp16"), val = tensor<fp16, [1]>([-0x1.908p-12])];
            tensor<fp16, [1, 1, 576, 1024]> residual_cast_fp16 = conv(bias = refiner_out_bias_to_fp16, dilations = residual_dilations_0, groups = residual_groups_0, pad = residual_pad_0, pad_type = residual_pad_type_0, strides = residual_strides_0, weight = refiner_out_weight_to_fp16, x = input_19_cast_fp16)[name = string("residual_cast_fp16")];
            tensor<fp16, [1, 1, 576, 1024]> var_77_cast_fp16 = add(x = alpha, y = residual_cast_fp16)[name = string("op_77_cast_fp16")];
            fp16 var_6_to_fp16 = const()[name = string("op_6_to_fp16"), val = fp16(0x0p+0)];
            fp16 var_5_to_fp16 = const()[name = string("op_5_to_fp16"), val = fp16(0x1p+0)];
            tensor<fp16, [1, 1, 576, 1024]> clip_0_cast_fp16 = clip(alpha = var_6_to_fp16, beta = var_5_to_fp16, x = var_77_cast_fp16)[name = string("clip_0_cast_fp16")];
            fp16 var_82_to_fp16 = const()[name = string("op_82_to_fp16"), val = fp16(0x1.47cp-7)];
            tensor<bool, [1, 1, 576, 1024]> var_83_cast_fp16 = greater(x = alpha, y = var_82_to_fp16)[name = string("op_83_cast_fp16")];
            fp16 var_84_to_fp16 = const()[name = string("op_84_to_fp16"), val = fp16(0x1.fbp-1)];
            tensor<bool, [1, 1, 576, 1024]> var_85_cast_fp16 = less(x = alpha, y = var_84_to_fp16)[name = string("op_85_cast_fp16")];
            tensor<bool, [1, 1, 576, 1024]> var_86 = logical_and(x = var_83_cast_fp16, y = var_85_cast_fp16)[name = string("op_86")];
            tensor<int32, [2]> var_94 = const()[name = string("op_94"), val = tensor<int32, [2]>([8, 8])];
            tensor<int32, [2]> var_97 = const()[name = string("op_97"), val = tensor<int32, [2]>([8, 8])];
            string input_23_pad_type_0 = const()[name = string("input_23_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_23_pad_0 = const()[name = string("input_23_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            bool input_23_ceil_mode_0 = const()[name = string("input_23_ceil_mode_0"), val = bool(false)];
            string input_21_to_fp16_dtype_0 = const()[name = string("input_21_to_fp16_dtype_0"), val = string("fp16")];
            tensor<fp16, [1, 1, 576, 1024]> var_86_to_fp16 = cast(dtype = input_21_to_fp16_dtype_0, x = var_86)[name = string("cast_6")];
            tensor<fp16, [1, 1, 72, 128]> input_23_cast_fp16 = max_pool(ceil_mode = input_23_ceil_mode_0, kernel_sizes = var_94, pad = input_23_pad_0, pad_type = input_23_pad_type_0, strides = var_97, x = var_86_to_fp16)[name = string("input_23_cast_fp16")];
            tensor<int32, [2]> var_108 = const()[name = string("op_108"), val = tensor<int32, [2]>([3, 3])];
            tensor<int32, [2]> var_111 = const()[name = string("op_111"), val = tensor<int32, [2]>([1, 1])];
            string input_pad_type_0 = const()[name = string("input_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_pad_0 = const()[name = string("input_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            bool input_ceil_mode_0 = const()[name = string("input_ceil_mode_0"), val = bool(false)];
            tensor<fp16, [1, 1, 72, 128]> input_cast_fp16 = max_pool(ceil_mode = input_ceil_mode_0, kernel_sizes = var_108, pad = input_pad_0, pad_type = input_pad_type_0, strides = var_111, x = input_23_cast_fp16)[name = string("input_cast_fp16")];
            fp32 band_scale_factor_height_0 = const()[name = string("band_scale_factor_height_0"), val = fp32(0x1p+3)];
            fp32 band_scale_factor_width_0 = const()[name = string("band_scale_factor_width_0"), val = fp32(0x1p+3)];
            tensor<fp16, [1, 1, 576, 1024]> band_cast_fp16 = upsample_nearest_neighbor(scale_factor_height = band_scale_factor_height_0, scale_factor_width = band_scale_factor_width_0, x = input_cast_fp16)[name = string("band_cast_fp16")];
            tensor<fp16, [1, 1, 576, 1024]> var_125_cast_fp16 = mul(x = band_cast_fp16, y = clip_0_cast_fp16)[name = string("op_125_cast_fp16")];
            fp16 var_126_promoted_to_fp16 = const()[name = string("op_126_promoted_to_fp16"), val = fp16(0x1p+0)];
            tensor<fp16, [1, 1, 576, 1024]> var_128_cast_fp16 = sub(x = var_126_promoted_to_fp16, y = band_cast_fp16)[name = string("op_128_cast_fp16")];
            tensor<fp16, [1, 1, 576, 1024]> var_129_cast_fp16 = mul(x = var_128_cast_fp16, y = alpha)[name = string("op_129_cast_fp16")];
            tensor<fp16, [1, 1, 576, 1024]> matte = add(x = var_125_cast_fp16, y = var_129_cast_fp16)[name = string("op_131_cast_fp16")];
        } -> (matte);
}